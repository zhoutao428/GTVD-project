PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/gtvd.db

# Data Sources (使用国内合规API)
KEYAPI_KEY=your_keyapi_key
JUHE_API_KEY=your_juhe_api_key
TIANXING_KEY=your_tianxing_key

# AI Analysis (DeepSeek/通义千问)
DEEPSEEK_API_KEY=your_deepseek_api_key
TONGYI_API_KEY=your_tongyi_api_key

# FFmpeg
FFMPEG_PATH=ffmpeg
FFMPEG_PROBE_PATH=ffprobe

# Video Settings
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=30
VIDEO_BITRATE=2000k
VIDEO_CODEC=libx264

# Storage (阿里云OSS)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your_bucket_name
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_REGION=oss-cn-hangzhou

# Alibaba Cloud TTS (语音合成)
TTS_ENDPOINT=https://nls-gateway.cn-shanghai.aliyuncs.com/stream/v1/tts
TTS_TOKEN=your_tts_token
TTS_APP_KEY=your_tts_app_key

# Alibaba Cloud MTS (媒体服务)
MTS_ENDPOINT=https://mts.cn-shanghai.aliyuncs.com
MTS_CALLBACK_URL=https://your-callback-url.com/callback

# Storage
VIDEO_OUTPUT_DIR=./output/videos
TEMP_DIR=./temp
BACKUP_DIR=./backups

# Scheduler
COLLECT_CRON=0 6 * * *
PROCESS_CRON=30 6 * * *
GENERATE_CRON=0 7 * * *
