# =============================================================================
# GTVD 全球热点AI视频日报系统 - 环境变量配置
# =============================================================================
# 复制此文件为 .env 并填入实际值
# 敏感信息不要提交到代码仓库
# =============================================================================

# ============ 基础配置 ============
PORT=3000
NODE_ENV=development
DB_PATH=./data/gtvd.db

# ============ AI 分析引擎（主）============
# DeepSeek - 热点分类、去重、爆款因子分析、推荐语生成
AI_API_KEY=sk-acf417a0f7bb4732a6bc6516a3de8094
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ============ 阿里云百炼（备用）============
# 通义千问备用模型，用于文本润色等辅助任务
DASHSCOPE_API_KEY=sk-e17ec272b46949e0809d1f3c6e97d7fc

# ============ Bright Data 代理配置 ============
# 海外平台数据采集代理
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335
BRIGHTDATA_PROXY_USERNAME=brd-customer-hl_25c9ff79-zone-gtvdproject1
BRIGHTDATA_PROXY_PASSWORD=q0p75kzm00bp

# ============ 国内热点数据（可选）============
# 聚合数据 - 国内平台热点数据
# JUHE_API_KEY=your_juhe_api_key

# 天行数据 - 备用国内数据源
# TIANXING_KEY=your_tianxing_key

# ============ 视频合成配置 ============
# FFmpeg 本地路径（留空使用系统默认）
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 视频参数
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_BITRATE=3000k
VIDEO_CODEC=libx264

# 本地输出目录
VIDEO_OUTPUT_DIR=./output/videos
TEMP_DIR=./temp
BACKUP_DIR=./backups

# ============ Edge TTS（语音合成）============
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ============ 阿里云 OSS（可选）============
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=your_bucket_name
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret

# ============ 企业微信通知（可选）============
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx

# ============ 定时任务配置 ============
COLLECT_CRON=0 0 * * *
PROCESS_CRON=30 0 * * *
GENERATE_CRON=0 8 * * *
